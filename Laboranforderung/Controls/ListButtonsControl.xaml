<UserControl x:Class="Laboranforderung.Controls.ListButtonsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Laboranforderung.Controls">
    <Grid DataContext="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:ListButtonsControl}}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" >
            <local:DoubleImageButton  x:Name="ButtonMoveDown"  Margin="2" Height="32" Width="32" ToolTip="Element nach unten verschieben" EnabledBrush="{DynamicResource Brush.MoveDown}" DisabledBrush="{DynamicResource Brush.MoveDown.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonMoveUp"  Margin="2,2,4,2" Height="32" Width="32" ToolTip="Element nach oben verschieben" EnabledBrush="{DynamicResource Brush.MoveUp}" DisabledBrush="{DynamicResource Brush.MoveUp.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonMoveLeft"  Margin="2" Height="32" Width="32" ToolTip="Element nach links verschieben" EnabledBrush="{DynamicResource Brush.MoveLeft}" DisabledBrush="{DynamicResource Brush.MoveLeft.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonMoveRight"  Margin="2,2,4,2" Height="32" Width="32" ToolTip="Element nach rechts verschieben" EnabledBrush="{DynamicResource Brush.MoveRight}" DisabledBrush="{DynamicResource Brush.MoveRight.Disabled}" />

        </StackPanel>
        <StackPanel Grid.Column="1"  Orientation="Horizontal">
            <local:DoubleImageButton  x:Name="ButtonEdit"  Margin="2,2,4,2" Height="32" Width="32" ToolTip="Element bearbeiten" EnabledBrush="{DynamicResource Brush.Edit}" DisabledBrush="{DynamicResource Brush.Edit.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonRemove"  Margin="2,2,4,2" Height="32" Width="32" ToolTip="Element löschen" EnabledBrush="{DynamicResource Brush.Delete}" DisabledBrush="{DynamicResource Brush.Delete.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonAdd"  Margin="2" Height="32" Width="32" ToolTip="Element hinzufügen" EnabledBrush="{DynamicResource Brush.Add}" DisabledBrush="{DynamicResource Brush.Add.Disabled}" />
            <local:DoubleImageButton  x:Name="ButtonAddKategorie"  Margin="2" Height="32" Width="32" ToolTip="Kategorie hinzufügen" EnabledBrush="{DynamicResource Brush.AddBlau}" DisabledBrush="{DynamicResource Brush.Add.Disabled}" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
