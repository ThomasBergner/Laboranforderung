<Window x:Class="Laboranforderung.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboranforderung"
        xmlns:converters="clr-namespace:Laboranforderung.Converters"
        xmlns:controls="clr-namespace:Laboranforderung.Controls"
        mc:Ignorable="d"
         Title="Laboranforderung" Height="800" Width="1200">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFBED3E9" Offset="0"/>
            <GradientStop Color="#FF7FADD2" Offset="1"/>
            <GradientStop Color="#FF98BBDB" Offset="0.5"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToVisibilityCollapseConverter x:Key="BooleanToVisibilityCollapseConverter" />
    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto">
        <Menu HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent">
            <MenuItem Header="Optionen" Click="OptionenMenuItem_Click"/>
            <MenuItem Header="Profile bearbeiten" Click="ProfileBearbeitenMenuItem_Click" Visibility="{Binding AllowChanges, Converter={StaticResource BooleanToVisibilityCollapseConverter}}"/>
        </Menu>
        <Grid ColumnDefinitions="250,8,*,8,250" Grid.Row="1" Margin="8">
            <Grid RowDefinitions="Auto,Auto,Auto,*" Grid.Column="0">
                <TextBlock Grid.Row="0"
                           Margin="0,0,0,4"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Text="Laborwerte" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                    <Menu Grid.Column="0" Background="Transparent" BorderBrush="Transparent">
                        <MenuItem Header="Suche" Command="{Binding ToggleSucheVisibleCommand}" FontSize="14"/>
                    </Menu>
                    <Menu Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent">
                        <MenuItem Header="Alle auf" Command="{Binding ExpandAllGroupsCommand}" FontSize="14"/>
                        <MenuItem Header="Alle zu" Command="{Binding CollapseAllGroupsCommand}" FontSize="14"/>
                    </Menu>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,4" Visibility="{Binding SucheVisible, Converter={StaticResource BooleanToVisibilityCollapseConverter}}">
                    <TextBox x:Name="FilterTextBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="0,0,25,0"
                             VerticalAlignment="Center" 
                             Background="#7FFFFFFF" />
                    <!-- Clear-Button (X) -->
                    <Button Content="✖" VerticalAlignment="Center" HorizontalAlignment="Right" 
                            Margin="0" 
                            Padding="5,2" 
                            Background="Transparent" 
                            BorderThickness="0" Cursor="Hand" ToolTip="Suchtext löschen"
                            FontSize="8"
                            Command="{Binding ClearFilterCommand}" >
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=FilterTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </Grid>


                <ListBox Grid.Row="3" x:Name="CheckLaborwertgruppenListBox" ItemsSource="{Binding SuchLaborwertgruppen}" 
                             ItemContainerStyle="{StaticResource ListBoxItemContainerStyleWithoutSelection}" Background="#7FFFFFFF">
                        
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" 
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" >

                                    <ToggleButton Grid.Column="0" x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  ClickMode="Press" IsChecked="{Binding IsExpanded}" 
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                  Width="14" Height="14" Margin="3,0,3,0" VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    
                                    <ListBox x:Name="CheckLaborwerteListBox" Grid.Row="1" Grid.Column="1"
                                             ItemsSource="{Binding CheckLaborwerte}" BorderThickness="0" 
                                             Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityCollapseConverter}}" 
                                             ItemContainerStyle="{StaticResource ListBoxItemContainerStyleWithoutSelection}" Background="Transparent">
                                        
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <controls:ActivatableCheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsActivatable="{Binding IsEnabled}" 
                                                            Style="{DynamicResource CustomCheckBoxStyle1}" Padding="5,2" Margin="1" ToolTip="{Binding InfoText}"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" 
                                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>


            </Grid>
            <!-- GridSplitter nach Column 0 -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ResizeDirection="Columns"
                            ResizeBehavior="PreviousAndNext"
                            ShowsPreview="True"
                            Background="Transparent" />

            <!-- Inhalte in der mittleren Spalte -->
            <Grid Grid.Column="2" RowDefinitions="1*,2*">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Text="Text" />
                    <Menu Grid.Row="1" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" >
                        <MenuItem Header="Reset" Command="{Binding RestartCommand}" FontSize="14"/>
                        <MenuItem Header="Kopieren" Command="{Binding ResultTextKopierenCommand}" FontSize="14"/>
                    </Menu>
       
                    <TextBox x:Name="ResultTextBox" Text="{Binding ResultText}" Grid.Row="2" FontSize="12" 
                             TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#7FFFFFFF"/>
                
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto,*">
                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Text="Laboranmeldung" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <TextBlock Text="Profile"
                                   FontSize="14"
                                   Margin="0,0,0,4"
                                   FontWeight="SemiBold" />
                        <Menu Grid.Column="1" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" >
                            <MenuItem Header="Optimieren" Command="{Binding OptimizeProfilesCommand}" FontSize="14"/>
                        </Menu>
                    </Grid>
                    <TextBox x:Name="ProfileTextBox" Grid.Row="2" Text="{Binding ProfileText}" FontSize="12" 
                             TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#7FFFFFFF"/>
                    <TextBlock Grid.Row="3" Text="Extra-Werte"
                               Margin="0,0,0,4"
                               FontWeight="SemiBold"
                               FontSize="14" />
                    <TextBox x:Name="ExtraValuesTextBox" Grid.Row="4" Text="{Binding RestLaborwerteText}" FontSize="12"
                             TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="#7FFFFFFF"/>
                </Grid>
            </Grid>
            <!-- GridSplitter vor rechter Spalte (ehemals Column 2) -->
            <GridSplitter Grid.Column="3"
                Width="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True"
                Background="Transparent" />

            <Grid RowDefinitions="Auto,Auto,*" Grid.Column="4">
                <TextBlock Grid.Row="0"
                Margin="0,0,0,4"
                FontWeight="SemiBold"
                FontSize="14"
                Text="Profile" />
                <Menu HorizontalAlignment="Right" Grid.Row="1" Background="Transparent" BorderBrush="Transparent">
                    <MenuItem Header="Alle auf" Command="{Binding ExpandAllProfilesCommand}" FontSize="14"/>
                    <MenuItem Header="Alle zu" Command="{Binding CollapseAllProfilesCommand}" FontSize="14"/>
                </Menu>
                <ListBox Grid.Row="2" x:Name="ProfileListBox" ItemsSource="{Binding CheckLaborprofile}" 
                             ItemContainerStyle="{DynamicResource ListBoxItemContainerStyleWithoutSelection}" Background="#7FFFFFFF">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" 
                                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" >

                                <ToggleButton Grid.Column="0" x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  ClickMode="Press" IsChecked="{Binding IsExpanded}" 
                                                  Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                  Width="14" Height="14" Margin="3,0,3,0" VerticalAlignment="Center" />

                                <CheckBox Grid.Column="1" Content="{Binding Name}" VerticalAlignment="Center" IsChecked="{Binding IsChecked}" 
                                              Style="{DynamicResource CustomCheckBoxStyle}" Padding="10,4" Margin="0,0,6,0"/>

                                <ListBox x:Name="CheckLaborwerteListBox" Grid.Row="1" Grid.Column="1"
                                             ItemsSource="{Binding CheckLaborwerte}" BorderThickness="0" 
                                             Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityCollapseConverter}}" 
                                             ItemContainerStyle="{StaticResource ListBoxItemContainerStyleWithoutSelection}" Background="Transparent">

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <controls:ActivatableCheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked}" IsActivatable="{Binding IsEnabled}" 
                                                                          Style="{DynamicResource CustomCheckBoxStyle1}" Padding="5,2" Margin="1" ToolTip="{Binding InfoText}"/>
                                        
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" 
                                                           Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

        </Grid>
        
        <StatusBar Grid.Row="2" Background="#CCF1EDED">
            <TextBlock Text="Status: Ready" />
        </StatusBar>
        <StackPanel Grid.Row="1" x:Name="ToastHost"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="20"
                Orientation="Vertical"
                />    
    </Grid>

    
</Window>
