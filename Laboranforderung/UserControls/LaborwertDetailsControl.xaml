<UserControl x:Class="Laboranforderung.UserControls.LaborwertDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Label Content="Laborwert" FontWeight="Bold" />
        <Label Content="Name" />
        <TextBox Text="{Binding Name}" />
        <Label Content="Bezeichnung" />
        <TextBox Text="{Binding Bezeichnung}" />
        <Label Content="Synonyme" />
        <TextBox Text="{Binding Synonyme}" />

    </StackPanel>
</UserControl>
