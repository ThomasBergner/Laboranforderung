<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Laboricon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\copy_16.png" />
    <None Remove="Assets\Copy_16x.png" />
    <None Remove="Assets\Print_16x.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Assets\Copy_16x.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Laboricon.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\copy_16.png" />
    <EmbeddedResource Include="Assets\Copy_16x.png" />
    <EmbeddedResource Include="Assets\Copy_16x.xaml">
      <Generator>MSBuild:Compile</Generator>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\Print_16x.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
