                <GeometryDrawing Brush="#00FFFFFF" Geometry="{StaticResource Pfad.Background}" />
                <GeometryDrawing Brush="{StaticResource Brush.Content.Orangerot}" Pen="{StaticResource Pen.Border.Darkrot}" Geometry="{StaticResource Pfad.Delete}" />
