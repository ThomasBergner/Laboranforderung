            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="{StaticResource Pfad.Background}" />
                <GeometryDrawing Brush="{StaticResource Brush.Content.Gruen}" Pen="{StaticResource Pen.Border.Gruen}" Geometry="{StaticResource Pfad.Add}" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

