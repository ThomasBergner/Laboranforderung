<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">




    <SolidColorBrush x:Key="Brush.Content.Blau" Color="#FF0065cb" />
    <SolidColorBrush x:Key="Brush.Content.Gruen" Color="#FF65cb32" />
    <SolidColorBrush x:Key="Brush.Content.Darkrot" Color="#FF980000" />
    <SolidColorBrush x:Key="Brush.Content.Orangerot" Color="#FFff784a" />
    <SolidColorBrush x:Key="Brush.Content.Orange" Color="#FFff9832" />
    <SolidColorBrush x:Key="Brush.Content.Grau" Color="#FFcbcbff" />
    <SolidColorBrush x:Key="Brush.Content.Disabled" Color="#FFA4A4A4" />
    
    <Pen x:Key="Pen.Border.Blau" Thickness="1" LineJoin="Round" Brush="#FF323265" />
    <Pen x:Key="Pen.Border.Gruen" Thickness="1" LineJoin="Round" Brush="#FF006500" />
    <Pen x:Key="Pen.Border.Darkrot" Thickness="1" LineJoin="Round" Brush="{StaticResource Brush.Content.Darkrot}" />
    <Pen x:Key="Pen.Border.Grau" Thickness="1" LineJoin="Round" Brush="#FF666680" />
    <Pen x:Key="Pen.Border.Disabled" Thickness="1" LineJoin="Round" Brush="#FF565656" /> 
    

    <PathGeometry x:Key="Pfad.Background16" Figures="M 0,0L 16,0L 16,16L 0,16L 0,0 Z " />
    <PathGeometry x:Key="Pfad.Background" Figures="M 0,0L 32,0L 32,32L 0,32L 0,0 Z " />
    <PathGeometry x:Key="Pfad.MoveRight" Figures="M 30,16 14,3 14,9 3,9 3,23 14,23 14,29 Z" />
    <PathGeometry x:Key="Pfad.MoveUp" Figures="M 16,2 3,18 9,18 9,29 23,29 23,18 29,18 Z" />
    <PathGeometry x:Key="Pfad.MoveLeft" Figures="M 3,16 19,29 19,23 30,23 30,9 19,9 19,3 Z" />
    <PathGeometry x:Key="Pfad.MoveDown" Figures="M 16,30 29,14 23,14 23,3 9,3 9,14 3,14 Z" />
    <PathGeometry x:Key="Pfad.Add" Figures="M 29,11 20,11 20,2 12,2 12,11 3,11 3,19 12,19 12,28 20,28 20,19 29,19 Z" />
