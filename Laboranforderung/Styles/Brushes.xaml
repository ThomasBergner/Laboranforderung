    <PathGeometry x:Key="Pfad.FolderOpen16" Figures="M 6,2 5,4 2,4 2,8 1,8 3,13 14,13 11,8 3,8 3,5 6,5 7,3 14,3 14,13 15,13 15,2 Z " />
    <PathGeometry x:Key="Pfad.FolderClosed16" Figures="M 7,2L6,4H2v9h13V2H7z M14,3v1H7.5L8,3H14 Z " />

    <PathGeometry x:Key="Icon.Tab" Figures="M 5,5 L 25,5 L 20,20 L 5,20 Z" />
    <DrawingImage x:Key="Img.Tab">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="{StaticResource Icon.Tab}"
                         Brush="#FF80A0FF"
                         Pen="{StaticResource Pen.Border.Disabled}" />
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingBrush x:Key="Brush.FolderOpen16" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="{StaticResource Pfad.Background16}" />
                <GeometryDrawing Brush="{StaticResource Brush.Content.Orange}" Geometry="{StaticResource Pfad.FolderOpen16}" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    <DrawingBrush x:Key="Brush.FolderClosed16" Stretch="Uniform">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#00FFFFFF" Geometry="{StaticResource Pfad.Background16}" />
                <GeometryDrawing Brush="{StaticResource Brush.Content.Orange}" Geometry="{StaticResource Pfad.FolderClosed16}" />
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <DrawingBrush x:Key="Brush.Add" Stretch="Uniform">
