<Window x:Class="Laboranforderung.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboranforderung"
        mc:Ignorable="d"
        Title="Laboranforderung - Profile drucken" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFBED3E9" Offset="0"/>
            <GradientStop Color="#FF7FADD2" Offset="1"/>
            <GradientStop Color="#FF98BBDB" Offset="0.5"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid RowDefinitions="Auto,*,Auto">
        <ToolBar Background="Transparent">
            <Button Width="75" Click="PrintButton_Click">
                
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/Print_16x.png" Width="16" Height="16" SnapsToDevicePixels="True" Stretch="None" />
                    <TextBlock Text="Drucken" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
        </ToolBar>
        <Grid Background="White" Margin="8" Grid.Row="1">
            <FlowDocumentReader x:Name="DocumentViewer" >
                <FlowDocument >

                </FlowDocument>
            </FlowDocumentReader>
        </Grid>

        <StatusBar Grid.Row="2" Background="#CCF1EDED">
            <TextBlock Text="Status: Ready" />
        </StatusBar>
    </Grid>
</Window>
