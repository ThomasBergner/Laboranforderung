<Window  x:Class="Laboranforderung.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboranforderung"
        xmlns:converters="clr-namespace:Laboranforderung.Converters" 
        xmlns:controls="clr-namespace:Laboranforderung.Controls"
         xmlns:selectors="clr-namespace:Laboranforderung.Selectors" 
         xmlns:usercontrols ="clr-namespace:Laboranforderung.UserControls"
        Title="Laboranforderung - Profile bearbeiten" Height="600" Width="1000">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFBED3E9" Offset="0"/>
            <GradientStop Color="#FF7FADD2" Offset="1"/>
            <GradientStop Color="#FF98BBDB" Offset="0.5"/>
        </LinearGradientBrush>
    </Window.Background>
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ReadableListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Empty -->
        <DataTemplate x:Key="EmptyTemplate">
            <usercontrols:EmptyDetailsControl />
        </DataTemplate>

        <!-- Gruppe -->
        <DataTemplate x:Key="GruppeTemplate">
            <usercontrols:LaborwertgruppeDetailsControl />
        </DataTemplate>

        <!-- Profil -->
        <DataTemplate x:Key="ProfilTemplate">
            <usercontrols:LaborprofilDetailsControl />
        </DataTemplate>

        <!-- Wert -->
        <DataTemplate x:Key="WertTemplate">
            <usercontrols:LaborwertDetailsControl />
        </DataTemplate>


        <!-- Selector -->
        <selectors:SelectedValueTemplateSelector x:Key="SelectedValueSelector"
                                  EmptyTemplate="{StaticResource EmptyTemplate}"
                                  GruppeTemplate="{StaticResource GruppeTemplate}"
                                  ProfilTemplate="{StaticResource ProfilTemplate}"
                                  WertTemplate="{StaticResource WertTemplate}" />

    </Window.Resources>
    <Grid RowDefinitions="Auto, *,Auto">
        <Menu Background="Transparent" >
            <MenuItem Header="Datei">
                <MenuItem Header="Neu" Command="{Binding NewFileCommand}"/>
                <MenuItem Header="Öffnen" Command="{Binding OpenFileCommand}"/>
                <MenuItem Header="Speichern" Command="{Binding SaveFileCommand}"/>
                <MenuItem Header="Speichern unter" Command="{Binding SaveFileAsCommand}"/>
                <Separator/>
                <MenuItem Header="CSV Importieren" Command="{Binding ImportFileCommand}"/>
                <MenuItem Header="CSV Exportieren" Command="{Binding ExportFileCommand}"/>
                <Separator/>
                <MenuItem x:Name="SchließenMenuItem" Header="Schließen" Click="SchließenMenuItem_Click"/>
            </MenuItem>
            <MenuItem Header="Optionen">
                <MenuItem Header="AutoOpen" IsCheckable="True" IsChecked="{Binding AutoOpen}"/>
                <MenuItem Header="AutoSave" IsCheckable="True" IsChecked="{Binding AutoSave}"/>
            </MenuItem>
            <MenuItem Header="Drucken" Click="DruckenMenuItem_Click"/>
        </Menu>
        <Grid Grid.Row="1" Margin="8" ColumnDefinitions="250,*,250" RowDefinitions="Auto,Auto,*,Auto">

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="Laborwertgruppen und Laborwerte" />

            <Menu Grid.Row="1" 
                  HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent">
                <MenuItem Header="Alle auf" Command="{Binding CmdGruppenentryExpandAll}"/>
                <MenuItem Header="Alle zu" Command="{Binding CmdGruppenentryCollapseAll}"/>
            </Menu>


            <ListBox Grid.Row="2" Grid.Column="0" x:Name="GruppenListBox" 
                 ItemsSource="{Binding Gruppenentries}"
                 SelectedItem="{Binding Gruppenentry, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ReadableListBoxItemStyle}"
                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                 MouseMove="ListBox_MouseMove"
                 DragOver="ListBox_DragOver"
                 Drop="GruppenListBox_Drop"
                 AllowDrop="True">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding Indent}" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="1"
                                      x:Name="Expander"
                                      Style="{StaticResource ExpandCollapseToggleStyle}"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsExpanded}"
                                      Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                                      Width="14"
                                      Height="14"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center" />

                            <TextBlock Grid.Column="2"
                                   Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>



            <controls:ListButtonsControl Grid.Row="3" Grid.Column="0" 
                                         LeftRightVisible="False" EditVisible="False" AddKategorieVisible="True"
                                         MoveDownCommand="{Binding CmdGruppenentryMoveDown}" MoveUpCommand="{Binding CmdGruppenentryMoveUp}"
                                         RemoveCommand="{Binding CmdGruppenentryRemove}" AddCommand="{Binding CmdGruppenlaborwertitemAdd}" 
                                         AddKategorieCommand="{Binding CmdGruppenitemAdd}"
                                         AddKategorieText="Neue Gruppe"  AddItemText="Neuer Laborwert"/>


            <TextBlock Grid.Row="0" Grid.Column="1"
                       Margin="0,0,0,4"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="Auswahl" />
            <ContentControl Grid.Row="2" Grid.Column="1"
                            Margin="8,0,8,0"
               Content="{Binding SelectedValue}"
               ContentTemplateSelector="{StaticResource SelectedValueSelector}" />



            <TextBlock Grid.Row="0" Grid.Column="2"
                       Margin="0,0,0,4"
                       FontWeight="SemiBold"
                       Text="Profile und zugeordnete Laborwerte" />

            <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">
                <Menu Background="Transparent" BorderBrush="Transparent">
                    <MenuItem Header="Sortieren" Command="{Binding CmdSortieren}" />
                </Menu>
                <Menu Background="Transparent" BorderBrush="Transparent" Grid.Column="1">
                    <MenuItem Header="Alle auf" Command="{Binding CmdProfilentryExpandAll}"/>
                    <MenuItem Header="Alle zu" Command="{Binding CmdProfilentryCollapseAll}"/>
                </Menu>
            </Grid>

            <Grid Grid.Row="2" Grid.Column="2" RowDefinitions="Auto,*">

                <ListBox x:Name="ProfilListBox" Grid.Row="1" 
                 ItemsSource="{Binding Profilentries}"
                 SelectedItem="{Binding Profilentry, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ReadableListBoxItemStyle}"
                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                 MouseMove="ListBox_MouseMove"
                 DragOver="ListBox_DragOver"
                 Drop="ProfilListBox_Drop"
                 AllowDrop="True">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding Indent}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton Grid.Column="1"
                              x:Name="Expander"
                              Style="{StaticResource ExpandCollapseToggleStyle}"
                              ClickMode="Press"
                              IsChecked="{Binding IsExpanded}"
                              Visibility="{Binding HasChildren, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Width="14"
                              Height="14"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                           Text="{Binding Name}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

            <controls:ListButtonsControl Grid.Row="3" Grid.Column="2" 
                                         LeftRightVisible="False" EditVisible="False"
                                         MoveDownCommand="{Binding CmdProfilentryMoveDown}" MoveUpCommand="{Binding CmdProfilentryMoveUp}"
                                         RemoveCommand="{Binding CmdProfilentryRemove}" AddCommand="{Binding CmdProfilentryAdd}" 
                                         AddItemText="Neues Profil"/>

        </Grid>

        <StatusBar Grid.Row="2" Background="#CCF1EDED">
            <TextBlock Text="Status: Ready" />
        </StatusBar>
    </Grid>
</Window>
